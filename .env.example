# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/storybook_db?retryWrites=true&w=majority

# Authentication Keys
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
SECRET_KEY=your-flask-secret-key-change-in-production

# AI API Keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
FREEPIK_API_KEY=your-freepik-api-key
GEMINI_API_KEY=your-gemini-api-key

# Monitoring (Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Redis Configuration (for caching and background tasks)
REDIS_URL=redis://localhost:6379/0

# Application Settings
FLASK_ENV=production
DEBUG=False

# Rate Limiting
RATE_LIMIT_STORIES_PER_DAY=5
